{
  "name": "biddify",
  "version": "0.1.0",
  "private": true,
  "description": "Biddify — internal RFQ bidding operating system",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "import:etenders": "tsx scripts/import-etenders.ts",
    "phase3:pilot": "tsx scripts/phase3-pilot.ts",
    "phase4:onboard": "tsx scripts/phase4-onboard-companies.ts",
    "phase4:discover-contacts": "tsx scripts/phase4-discover-supplier-contacts.ts",
    "phase4:cert-preview": "tsx scripts/phase4-certification-preview.ts",
    "secret-scan": "bash scripts/secret-scan.sh",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run secret-scan",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.1.0",
    "next": "16.4.0",
    "pdf-parse": "^1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.5.2",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^26.1.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vite": "6.3.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
