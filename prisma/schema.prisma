// Biddify domain model — Phase 4 operational sourcing
// Local/dev: SQLite may remain for certification. Production: PostgreSQL before multi-user/remote.
// Switch provider + DATABASE_URL when deploying; review migrations first.
// DEMO entities are fixtures only — never used for real outbound or real RFQ bidding.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

