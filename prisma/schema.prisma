enum ReadinessState {
  READY
  ACTION_REQUIRED
  NOT_APPLICABLE
  UNKNOWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(READ_ONLY)
  isActive     Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  approvals     Approval[]      @relation("ApprovalApprover")
  auditEvents   AuditEvent[]
  statusChanges RfqStatusEvent[]
}

model Company {
  id                 String   @id @default(cuid())
  legalName          String
  tradingName        String?
  registrationNumber String?
  csdNumber          String?
  csdMaaaNumber      String?
  taxNumber          String?
  vatRegistered      Boolean  @default(false)
  /// False until VAT status verified from CSD/tax docs — never invent.
  vatStatusKnown     Boolean  @default(false)
  vatNumber          String?
  beeLevel           String?
  beeExpiry          DateTime?
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankBranchCode     String?
  physicalAddress    String?
  postalAddress      String?
  province           String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  /// Operational sourcing signatory — NOT inferred from CSD / Gmail profile / mailbox username.
  authorisedSourcingSignatoryName String?
  authorisedSourcingSignatoryEmail String?
  authorisedSourcingSignatoryConfirmedAt DateTime?
  authorisedSourcingSignatoryConfirmedBy String?
  /// Registry-approved sourcing mailbox for this company (authoritative with domain registry).
  approvedSourcingMailbox String?
  commodityNotes     String?
  commodityCategories String?
  geographicCoverage String?
  capabilities       String?
  restrictions       String?
  relatedCompanyGroupId String?
  relatedCompanyNotes String?
  evidenceSource     String?
  readinessOverall   ReadinessState @default(UNKNOWN)
  readinessDetails   String?
  outboundSourcingEnabled Boolean @default(false)
  dataMode           DataMode @default(OPERATIONAL)
  notes              String?
  isDemo             Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents     CompanyDocument[]
  rfqs          Rfq[]
  bids          Bid[]
  gmailAccounts GmailAccount[]
  emails        EmailMessage[]
  sourcingRequests SourcingRequest[]

  @@index([isDemo])
  @@index([dataMode])
  @@index([relatedCompanyGroupId])
}

model CompanyDocument {
  id               String               @id @default(cuid())
  companyId        String
  documentType     String
  title            String
  issueDate        DateTime?
  expiryDate       DateTime?
  version          String?
  verificationState ComplianceItemState @default(AVAILABLE)
  storageKey       String?
  localPath        String?
  contentHash      String?
  sourcePath       String?
  uploadedAt       DateTime             @default(now())
  notes            String?
  isDemo           Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contentHash])
}

model Supplier {
  id                  String   @id @default(cuid())
  name                String
  website             String?
  email               String?
  /// False until email verified from published/confirmed source — never invent.
  emailVerified       Boolean  @default(false)
  emailEvidence       String?
  telephone           String?
  categories          String?
  brands              String?
  geographicCoverage  String?
  paymentTerms        String?
  deliveryCapability  String?
  reliabilityNotes    String?
  responseSpeedNotes  String?
  notes               String?
  supplierType        String?
  discoverySource     String?
  verificationStatus  String   @default("UNVERIFIED")
  evidenceUrl         String?
  location            String?
  suppressionReason   SupplierSuppressionReason?
  suppressedAt        DateTime?
  suppressionNotes    String?
  rfqsRequestedCount  Int      @default(0)
  responsesCount      Int      @default(0)
  quotesCount         Int      @default(0)
  lastContactedAt     DateTime?
  medianResponseHours Float?
  scoreBreakdown      String?
  scoreTotal          Float?
  dataMode            DataMode @default(OPERATIONAL)
  isDemo              Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contacts  SupplierContact[]
  contactChannels SupplierContactChannel[]
  quotes    SupplierQuote[]
  enquiries SupplierEnquiry[]
  emails    EmailMessage[]
  sourcingRequests SourcingRequest[]
  suppressions SupplierSuppression[]

  @@index([isDemo])
  @@index([email])
}

model SupplierContactChannel {
  id              String             @id @default(cuid())
  supplierId      String
  channelType     ContactChannelType
  email           String?
  phone           String?
  url             String?
  sourceUrl       String
  sourceType      String
  purpose         String?
  confidence      ContactConfidence  @default(UNVERIFIED)
  verifiedAt      DateTime?
  evidenceNotes   String?
  isPrimaryQuoteChannel Boolean      @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([email])
  @@index([channelType])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  email      String?
  telephone  String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model Rfq {
  id                    String             @id @default(cuid())
  internalId            String             @unique
  source                String
  /// Deterministic source identity key (e.g. OCDS ocid). Unique with source.
  sourceOpportunityId   String?
  sourceReference       String?
  tenderNumber          String?
  ocid                  String?
  buyer                 String
  department            String?
  title                 String
  description           String?
  category              String?
  province              String?
  municipality          String?
  deliveryAddress       String?
  publicationDate       DateTime?
  sourcePublishedAt     DateTime?
  sourceLastModifiedAt  DateTime?
  importedAt            DateTime?
  rawSourceMetadata     String?
  briefingDate          DateTime?
  briefingCompulsory    Boolean            @default(false)
  /// False when source does not state whether briefing is compulsory.
  briefingCompulsoryKnown Boolean          @default(false)
  questionsDeadline     DateTime?
  closingAt             DateTime
  /// False when source provided a date but no closing time — do not invent 23:59.
  closingTimeKnown      Boolean            @default(true)
  timezone              String             @default("Africa/Johannesburg")
  submissionMethod      SubmissionMethod   @default(UNKNOWN)
  submissionEmail       String?
  submissionPortal      String?
  physicalSubmission    String?
  estimatedValue        Decimal?
  contractDuration      String?
  deliveryPeriod        String?
  paymentTerms          String?
  sourceUrl             String?
  status                PipelineStatus     @default(NEW)
  opportunityScore      Int?
  commercialScore       Int?
  complianceScore       Int?
  profitabilityGate     ProfitabilityGate  @default(UNREVIEWED)
  opportunityScoreNotes String?
  opportunityScoreBreakdown String?
  classification        OpportunityClass?
  classificationConfidence Float?
  classificationReasoning String?
  classificationSource  ClassificationSource?
  classificationOverride OpportunityClass?
  qualificationGate     ProfitabilityGate  @default(UNREVIEWED)
  qualificationReasons  String?
  qualificationSnapshot String?
  qualificationOverride ProfitabilityGate?
  nextAction            NextAction?
  nextActionReason      String?
  noBidReason           String?
  noBidCategory         NoBidCategory?
  noBidNotes            String?
  noBidDecidedAt        DateTime?
  selectedCompanyId     String?
  duplicateOfId         String?
  duplicateGroupId      String?
  /// True for genuine procurement source imports (not DEMO seed).
  isRealSource          Boolean            @default(false)
  isDemo                Boolean            @default(false)
  dataMode              DataMode           @default(OPERATIONAL)
  recommendedCompanyId  String?
  companySelectionReason String?
  companySelectionBlockers String?
  sourcingStrategy      SourcingStrategy?
  sourcingHold          Boolean            @default(false)
  sourcingStopReason    String?
  costConfidence        Int?
  costConfidenceReasons String?
  specConfidence        Int?
  specConfidenceReasons String?
  bidPriority           Int?
  bidPriorityReasons    String?
  capitalEfficiency     Float?
  fundingRequired       Boolean            @default(false)
  inFounderBidQueue     Boolean            @default(false)
  /// Commercial sourcing plan (Founder must confirm SYSTEM_RECOMMENDATION).
  sourcingStrategyType  SourcingStrategyType @default(UNDECIDED)
  sourcingStrategyConfirmed Boolean        @default(false)
  sourcingStrategyJson  String?
  sourcingStrategyConfirmedAt DateTime?
  sourcingStrategyConfirmedBy String?
  commercialsApprovedAt DateTime?
  commercialsApprovedBy String?
  commercialsRejectedAt DateTime?
  commercialsRejectionReason String?
  eligibilityWarningAcceptedAt DateTime?
  eligibilityWarningAcceptedBy String?
  pricingBasis          PricingBasis       @default(PROVISIONAL)
  /// Autonomous RFQ Engine V1 lifecycle (prep only — never submission).
  autonomousState       AutonomousProcessingState?
  autonomousOutcome     AutonomousOutcome?
  autonomousStartedAt   DateTime?
  autonomousCompletedAt DateTime?
  autonomousDurationMs  Int?
  autonomousFailureReason String?
  autonomousRetryCount  Int                @default(0)
  autonomousConfidence  Float?
  autonomousWorkerVersion String?
  autonomousLastStep    String?
  autonomousClaimToken  String?
  autonomousClaimExpiresAt DateTime?
  autonomousRunJson     String?
  /// Live web research metrics JSON (coverage, timing, sources).
  liveResearchMetricsJson String?
  webResearchCoverage   Float?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  selectedCompany Company?          @relation(fields: [selectedCompanyId], references: [id])
  duplicateOf     Rfq?              @relation("RfqDuplicates", fields: [duplicateOfId], references: [id])
  duplicates      Rfq[]             @relation("RfqDuplicates")
  lineItems       RfqLineItem[]
  requirements    RfqRequirement[]
  documents       RfqDocument[]
  quotes          SupplierQuote[]
  pricingScenarios PricingScenario[]
  complianceItems ComplianceRequirement[]
  bids            Bid[]
  statusEvents    RfqStatusEvent[]
  enquiries       SupplierEnquiry[]
  emails          EmailMessage[]
  sourcingRequests SourcingRequest[]
  productResearchCandidates ProductResearchCandidate[]
  autonomousQuotations AutonomousQuotation[]
  researchObservations ResearchObservation[]

  @@unique([source, sourceOpportunityId])
  @@index([status])
  @@index([closingAt])
  @@index([selectedCompanyId])
  @@index([isRealSource])
  @@index([classification])
  @@index([nextAction])
  @@index([duplicateGroupId])
  @@index([inFounderBidQueue])
  @@index([dataMode])
  @@index([autonomousState])
  @@index([autonomousOutcome])
  @@index([autonomousClaimExpiresAt])
}

model RfqLineItem {
  id                    String                 @id @default(cuid())
  rfqId                 String
  lineNumber            Int
  product               String?
  description           String
  specification         String?
  brandRequirement      String?
  brand                 String?
  model                 String?
  sku                   String?
  equivalentAllowed     Boolean                @default(true)
  mandatoryCharacteristics String?
  quantity              Decimal
  unit                  String                 @default("EA")
  deliveryDestination   String?
  notes                 String?
  verificationStatus    ExtractionVerification @default(UNVERIFIED)
  extractionMethod      String?
  extractionConfidence  Float?
  sourceDocumentId      String?
  sourcePage            String?
  sourceSection         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  rfq               Rfq                  @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sourceDocument    RfqDocument?         @relation(fields: [sourceDocumentId], references: [id])
  quoteLineItems    SupplierQuoteLineItem[]
  pricingLineItems  PricingLineItem[]
  researchCandidates ProductResearchCandidate[]

  @@index([rfqId])
}

model ProductResearchCandidate {
  id                String               @id @default(cuid())
  rfqId             String
  rfqLineItemId     String
  sourceName        String
  sourceType        String
  productName       String
  brand             String?
  modelSku          String?
  productUrl        String?
  price             Decimal?
  priceKnown        Boolean              @default(false)
  vatTreatment      String?
  packSize          Decimal?
  packUnit          String?
  effectiveUnitCost Decimal?
  availability      String?
  deliveryCost      Decimal?
  deliveryKnown     Boolean              @default(false)
  evidenceLevel     PricingEvidenceLevel @default(PUBLIC_PRICE_REFERENCE)
  retrievedAt       DateTime             @default(now())
  evidenceAgeHours  Float?
  rawEvidenceJson   String?
  matchVerdict      SpecMatchVerdict     @default(INSUFFICIENT_INFORMATION)
  matchConfidence   Float?
  matchReasoning    String?
  matchedAttributes String?
  missingAttributes String?
  conflictingAttributes String?
  selected          Boolean              @default(false)
  unresolved        Boolean              @default(false)
  selectionStatus   String?
  selectionReason   String?
  researchProvider  String?
  sourceQuality     Float?
  priceType         String?
  packCalculationJson String?
  deliveryJson      String?
  attributeComparisonsJson String?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  rfq         Rfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  rfqLineItem RfqLineItem @relation(fields: [rfqLineItemId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([rfqLineItemId])
  @@index([selected])
  @@index([productUrl])
}

/// Granular live research evidence (queries, pages, prices) for drill-down.
model ResearchObservation {
  id            String   @id @default(cuid())
  rfqId         String
  rfqLineItemId String?
  eventType     String
  queryText     String?
  sourceUrl     String?
  domain        String?
  payloadJson   String?
  retrievedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([rfqLineItemId])
  @@index([eventType])
  @@index([sourceUrl])
  @@unique([rfqId, rfqLineItemId, sourceUrl, eventType])
}

model AutonomousQuotation {
  id                String   @id @default(cuid())
  rfqId             String
  quotationNumber   String
  companyLegalName  String
  companyId         String?
  institution       String
  rfqReference      String?
  quotationDate     DateTime @default(now())
  validityDays      Int?
  validityUntil     DateTime?
  currency          String   @default("ZAR")
  linesJson         String
  subtotalExVat     Decimal
  vatAmount         Decimal  @default(0)
  deliveryAmount    Decimal  @default(0)
  totalAmount       Decimal
  vatRegistered     Boolean
  commercialNotes   String?
  /// Customer-facing body only — never includes cost/markup/margin/URLs/confidence.
  customerFacingJson String
  internalSnapshotJson String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([quotationNumber])
}

model RfqRequirement {
  id                 String         @id @default(cuid())
  rfqId              String
  category           String
  requirementType    String?
  description        String
  isMandatory        Boolean        @default(true)
  sourceHint         String?
  sourceDocument     String?
  sourcePage         String?
  verificationStatus String         @default("UNVERIFIED")
  provenance         FactProvenance @default(HEURISTIC)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model RfqDocument {
  id              String                  @id @default(cuid())
  rfqId           String
  fileName        String
  documentType    String?
  storageKey      String?
  localPath       String?
  sourceUrl       String?
  format          String?
  pageCount       Int?
  byteSize        Int?
  contentHash     String?
  retrievedAt     DateTime?
  extractedAt     DateTime?
  processingState DocumentProcessingState @default(PENDING)
  extractedText   String?
  isSource        Boolean                 @default(true)
  notes           String?
  isDemo          Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  rfq       Rfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lineItems RfqLineItem[]

  @@index([rfqId])
  @@index([contentHash])
}

model SupplierQuote {
  id               String            @id @default(cuid())
  rfqId            String
  supplierId       String
  quoteReference   String?
  quoteDate        DateTime?
  receivedAt       DateTime          @default(now())
  validUntil       DateTime?
  currency         String            @default("ZAR")
  contactPerson    String?
  supplierEmail    String?
  /// Supplier VAT registration status — independent of bidding company VAT.
  supplierVatStatus SupplierVatStatus @default(UNKNOWN)
  /// Null means delivery cost UNKNOWN — never treat as free.
  deliveryCost     Decimal?
  deliveryKnown    Boolean           @default(false)
  deliveryLocation String?
  deliveryTerms    String?
  leadTimeDays     Int?
  paymentTerms     String?
  /// Null means VAT treatment UNKNOWN — never invent.
  vatIncluded      Boolean?
  vatKnown         Boolean           @default(false)
  subtotal         Decimal?
  vatAmount        Decimal?
  totalAmount      Decimal?
  evidenceType     QuoteEvidenceType @default(UNKNOWN)
  verificationState ExtractionVerification @default(UNVERIFIED)
  sourceDocumentPath String?
  sourceReference  String?
  captureMethod    String            @default("MANUAL")
  capturedBy       String?
  capturedAt       DateTime          @default(now())
  verifiedBy       String?
  verifiedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  notes            String?
  isComplete       Boolean           @default(false)
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  rfq       Rfq                    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier  Supplier               @relation(fields: [supplierId], references: [id])
  lineItems SupplierQuoteLineItem[]

  @@index([rfqId])
  @@index([supplierId])
  @@index([evidenceType])
  @@index([verificationState])
}

model SupplierQuoteLineItem {
  id                String         @id @default(cuid())
  supplierQuoteId   String
  rfqLineItemId     String?
  description       String
  quantity          Decimal
  unit              String?
  /// Null means unit price UNKNOWN — never invent zero.
  unitCost          Decimal?
  priceKnown        Boolean        @default(false)
  lineTotal         Decimal?
  vatTreatment      String?
  brandOffered      String?
  modelOffered      String?
  sku               String?
  manufacturer      String?
  specificationNotes String?
  complianceNotes   String?
  matchState        SpecMatchState @default(UNKNOWN)
  mappingConfidence Float?
  mappingNotes      String?
  availability      String?
  leadTimeDays      Int?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  supplierQuote SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)
  rfqLineItem   RfqLineItem?  @relation(fields: [rfqLineItemId], references: [id])

  @@index([supplierQuoteId])
  @@index([rfqLineItemId])
}

model SupplierEnquiry {
  id             String               @id @default(cuid())
  rfqId          String
  supplierId     String
  subject        String
  body           String
  deliveryState  EnquiryDeliveryState @default(DRAFT_NOT_SENT)
  productsSummary String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  rfq      Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([rfqId])
  @@index([supplierId])
}

model PricingScenario {
  id                     String             @id @default(cuid())
  rfqId                  String
  name                   String             @default("Primary")
  version                Int                @default(1)
  previousScenarioId     String?
  pricingBasis           PricingBasis       @default(PROVISIONAL)
  markupPercent          Decimal            @default(20)
  supplierCostTotal      Decimal            @default(0)
  /// Supplier invoice may include irrecoverable input VAT for non-VAT companies.
  supplierInputVatCost   Decimal            @default(0)
  deliveryCost           Decimal            @default(0)
  logisticsCost          Decimal            @default(0)
  packagingCost          Decimal            @default(0)
  insuranceCost          Decimal            @default(0)
  financingCost          Decimal            @default(0)
  contingencyCost        Decimal            @default(0)
  otherDirectCosts       Decimal            @default(0)
  landedCost             Decimal            @default(0)
  sellingPriceExVat      Decimal            @default(0)
  vatAmount              Decimal            @default(0)
  totalQuotation         Decimal            @default(0)
  grossProfit            Decimal            @default(0)
  grossMarginPercent     Decimal            @default(0)
  workingCapitalRequired Decimal            @default(0)
  upfrontCashRequired    Decimal            @default(0)
  expectedRecoveryDays   Int?
  supplierPaymentTerms   String?
  buyerPaymentTerms      String?
  financingAssumption    String?
  evidenceQuality        String?
  evidenceQuoteIds       String?
  profitabilityGate      ProfitabilityGate  @default(UNREVIEWED)
  profitabilityReasons   String?
  vatRegisteredSnapshot  Boolean?
  notes                  String?
  isSelected             Boolean            @default(false)
  isDemo                 Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  rfq       Rfq               @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lineItems PricingLineItem[]
  approvals Approval[]

  @@index([rfqId])
  @@index([previousScenarioId])
}

model PricingLineItem {
  id                String   @id @default(cuid())
  pricingScenarioId String
  rfqLineItemId     String?
  description       String
  quantity          Decimal
  unitCost          Decimal
  lineCost          Decimal
  unitSell          Decimal
  lineSell          Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pricingScenario PricingScenario @relation(fields: [pricingScenarioId], references: [id], onDelete: Cascade)
  rfqLineItem     RfqLineItem?    @relation(fields: [rfqLineItemId], references: [id])

  @@index([pricingScenarioId])
}

model ComplianceRequirement {
  id          String               @id @default(cuid())
  rfqId       String
  itemKey     String
  label       String
  isMandatory Boolean              @default(true)
  state       ComplianceItemState  @default(MISSING)
  notes       String?
  /// Evidence / source for this checklist item — never invent requirements without source.
  evidenceSource String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([rfqId, itemKey])
  @@index([rfqId])
}

model Bid {
  id                    String           @id @default(cuid())
  rfqId                 String
  companyId             String
  status                PipelineStatus   @default(PRICING)
  approvedPrice         Decimal?
  submissionMethod      SubmissionMethod @default(UNKNOWN)
  founderApprovedAt     DateTime?
  submissionAuthorisedAt DateTime?
  submittedAt           DateTime?
  isDemo                Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  rfq       Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id])
  approvals Approval[]

  @@index([rfqId])
  @@index([companyId])
}

model Approval {
  id                    String   @id @default(cuid())
  bidId                 String?
  pricingScenarioId     String?
  approverId            String
  approvedAt            DateTime @default(now())
  approvedPrice         Decimal
  approvedCompanyId     String?
  approvedSupplierConfig String?
  approvedSubmissionMethod SubmissionMethod @default(UNKNOWN)
  comments              String?
  isValid               Boolean  @default(true)
  invalidatedAt         DateTime?
  invalidationReason    String?
  isDemo                Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bid             Bid?             @relation(fields: [bidId], references: [id])
  pricingScenario PricingScenario? @relation(fields: [pricingScenarioId], references: [id])
  approver        User             @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([bidId])
  @@index([approverId])
}

model RfqStatusEvent {
  id         String          @id @default(cuid())
  rfqId      String
  fromStatus PipelineStatus?
  toStatus   PipelineStatus
  userId     String?
  reason     String?
  createdAt  DateTime        @default(now())

  rfq  Rfq   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([rfqId])
}

model AuditEvent {
  id           String      @id @default(cuid())
  action       AuditAction
  entityType   String
  entityId     String?
  userId       String?
  previousState String?
  newState     String?
  metadata     String?
  createdAt    DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model EmailMessage {
  id               String             @id @default(cuid())
  gmailAccountId   String?
  companyId        String?
  rfqId            String?
  supplierId       String?
  sourcingRequestId String?
  direction        EmailDirection     @default(OUTBOUND)
  gmailMessageId   String?
  gmailThreadId    String?
  sender           String
  recipients       String
  cc               String?
  subject          String
  bodyText         String?
  bodyHtml         String?
  classification   EmailClassification @default(UNKNOWN)
  classificationConfidence Float?
  processingState  String             @default("PENDING")
  deliveryState    String             @default("DRAFT")
  workflow         String?
  idempotencyKey   String?            @unique
  isMock           Boolean            @default(false)
  isRelevant       Boolean            @default(true)
  sentAt           DateTime?
  receivedAt       DateTime?
  errorMessage     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  gmailAccount    GmailAccount?    @relation(fields: [gmailAccountId], references: [id])
  company         Company?         @relation(fields: [companyId], references: [id])
  rfq             Rfq?             @relation(fields: [rfqId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  sourcingRequest SourcingRequest? @relation(fields: [sourcingRequestId], references: [id])
  attachments     EmailAttachment[]

  @@index([rfqId])
  @@index([gmailThreadId])
  @@index([gmailMessageId])
  @@index([companyId])
  @@index([supplierId])
}

model EmailAttachment {
  id              String   @id @default(cuid())
  emailMessageId  String
  fileName        String
  mimeType        String?
  byteSize        Int?
  contentHash     String?
  localPath       String?
  storageKey      String?
  createdAt       DateTime @default(now())

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@index([contentHash])
}

model GmailAccount {
  id                 String                @id @default(cuid())
  emailAddress       String                @unique
  googleAccountId    String?
  companyId          String?
  connectionStatus   GmailConnectionStatus @default(DISCONNECTED)
  scopesGranted      String?
  sendingEnabled     Boolean               @default(false)
  receivingEnabled   Boolean               @default(true)
  mappedAt           DateTime?
  mappingConfirmedBy String?
  lastSuccessfulSync DateTime?
  lastFailedSync     DateTime?
  syncError          String?
  labelBiddifyId     String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company  Company?       @relation(fields: [companyId], references: [id])
  token    GmailToken?
  emails   EmailMessage[]
  sourcingRequests SourcingRequest[]

  @@index([companyId])
  @@index([connectionStatus])
}

/// Encrypted OAuth tokens — never expose in UI/logs/git.
model GmailToken {
  id                   String   @id @default(cuid())
  gmailAccountId       String   @unique
  encryptedAccessToken String
  encryptedRefreshToken String?
  tokenExpiry          DateTime?
  encryptionVersion    Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  gmailAccount GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
}

model SourcingRequest {
  id               String               @id @default(cuid())
  reference        String               @unique
  rfqId            String
  companyId        String
  supplierId       String
  gmailAccountId   String?
  enquiryId        String?
  idempotencyKey   String               @unique
  recipientEmail   String
  subject          String
  body             String
  /// Neutral supplier-facing reference (e.g. RFQ-CONS-…). Internal BID refs stay on `reference`.
  externalReference String?
  /// Immutable approved sender from company mailbox registry — never substituted at send time.
  approvedSenderGmail String?
  /// Email-deferred lifecycle — PENDING_EMAIL_INTEGRATION until real transport exists.
  lifecycleStatus  SourcingLifecycleStatus @default(DRAFT)
  strategy         SourcingStrategy     @default(FORMAL_SUPPLIER_QUOTE_REQUIRED)
  deliveryState    EnquiryDeliveryState @default(DRAFT_NOT_SENT)
  certificationBatch Boolean            @default(false)
  founderApprovedAt DateTime?
  founderApprovedBy String?
  sentAt           DateTime?
  gmailMessageId   String?
  gmailThreadId    String?
  followUpCount    Int                  @default(0)
  maxFollowUps     Int                  @default(2)
  nextFollowUpAt   DateTime?
  stopReason       String?
  errorMessage     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  rfq          Rfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id])
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  gmailAccount GmailAccount? @relation(fields: [gmailAccountId], references: [id])
  emails       EmailMessage[]

  @@index([rfqId])
  @@index([supplierId])
  @@index([companyId])
  @@index([deliveryState])
}

model SupplierSuppression {
  id         String                    @id @default(cuid())
  supplierId String
  email      String?
  reason     SupplierSuppressionReason
  notes      String?
  createdAt  DateTime                  @default(now())
  liftedAt   DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([email])
}

model SystemSettings {
  id                        String       @id @default("default")
  outboundMode              OutboundMode @default(DISABLED)
  globalOutboundPaused      Boolean      @default(true)
  certificationPassedAt     DateTime?
  autonomyAuthorisedAt      DateTime?
  autonomyAuthorisedBy      String?
  /// V1: autonomous RFQ preparation (classify→quote draft). Never submission.
  autonomousPrepEnabled     Boolean      @default(true)
  /// HARD OFF — V1 must never auto-submit tenders.
  autonomousSubmissionEnabled Boolean    @default(false)
  maxEmailsPerHour          Int          @default(10)
  maxEmailsPerDay           Int          @default(40)
  maxEmailsPerSupplierPerDay Int         @default(2)
  maxEmailsPerCompanyPerDay Int          @default(20)
  supplierCooldownHours     Int          @default(72)
  maxFollowUps              Int          @default(2)
  totalProcurementCapitalLimit Decimal?
  notes                     String?
  updatedAt                 DateTime     @updatedAt
  createdAt                 DateTime     @default(now())
}

model CompanyCapitalLimit {
  id            String   @id @default(cuid())
  companyId     String   @unique
  capitalLimit  Decimal
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
