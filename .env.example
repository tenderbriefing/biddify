# Biddify environment template — copy to .env for local development.
# NEVER commit real secrets, production credentials, or Gmail OAuth tokens.

# SQLite for Phase 1 local/demo (zero infra cost).
# Production target: PostgreSQL, e.g. postgresql://USER:PASSWORD@HOST:5432/biddify
DATABASE_URL="file:./dev.db"

# Session signing secret (min 16 characters). Generate a long random string.
AUTH_SECRET="replace-with-a-long-random-secret"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Biddify"
APP_TIMEZONE="Africa/Johannesburg"

# Public eTenders OCDS (no API key). Override only if National Treasury publishes a new base.
ETENDERS_OCDS_BASE_URL="https://ocds-api.etenders.gov.za/api/OCDSReleases"

# --- Optional later adapters (DO NOT configure production until Founder approval) ---
# TENDERBRIEFING_API_URL=
# TENDERBRIEFING_API_KEY=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=
# DOCUMENT_STORAGE_BUCKET=
# DOCUMENT_STORAGE_ACCESS_KEY=
# DOCUMENT_STORAGE_SECRET_KEY=
# DOCUMENT_STORAGE_ENDPOINT=
# AI_PROVIDER=
# AI_API_KEY=

# Outbound email: mock | certification | autonomous (app also uses SystemSettings).
EMAIL_MODE="mock"

# Gmail OAuth (Desktop / loopback client recommended for local certification).
# Do NOT commit real client secrets. Tokens encrypted with TOKEN_ENCRYPTION_KEY or AUTH_SECRET.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI="http://127.0.0.1:3000/api/gmail/callback"
# TOKEN_ENCRYPTION_KEY=
